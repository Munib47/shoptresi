{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}
{{ 'component-rte.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .image-with-text__media img {
    height: 100%;
    width: auto;
    object-fit: cover;
    max-width: 100%;
  }

  .desktop-image-with-text {
    display: block;
    width: 100%;
  }

  .desktop-image-with-text .image-with-text__media {
    height: var(--desktop-height, 50vw);
  }

  .mobile-image-with-text {
    display: none;
    width: 100%;
  }

  .mobile-image-with-text .image-with-text__media {
    height: var(--mobile-height, 40vw);
  }

  .custom-image-with-text__content {
    position: static;
    /* padding: 6rem 7rem 7rem 0rem; */
  }

  @media (max-width: 768px) {
    .desktop-image-with-text {
      display: none;
    }
    .mobile-image-with-text {
      display: block;
    }
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="image-with-text image-with-text--{{ section.settings.content_layout }} page-width isolate{% if settings.text_boxes_border_thickness > 0 and settings.text_boxes_border_opacity > 0 and settings.media_border_thickness > 0 and settings.media_border_opacity > 0 %} collapse-borders{% endif %}{% unless section.settings.color_scheme == 'background-1' and settings.media_border_thickness > 0 and settings.text_boxes_shadow_opacity == 0 and settings.text_boxes_border_thickness == 0 or settings.text_boxes_border_opacity == 0 %} collapse-corners{% endunless %} section-{{ section.id }}-padding">
  <div class="image-with-text__grid grid grid--gapless grid--1-col grid--{% if section.settings.desktop_image_width == 'medium' %}2-col-tablet{% else %}3-col-tablet{% endif %}{% if section.settings.layout == 'text_first' %} image-with-text__grid--reverse{% endif %}">
    <div class="desktop-image-with-text image-with-text__media-item grid__item">
      <div
        class="image-with-text__media image-with-text__media--{{ section.settings.height }} color-{{ section.settings.color_scheme }} global-media-settings"
        data-desktop-height="{{ section.settings.desktop_height }}"
      >
        {%- if section.settings.desktop_image != blank -%}
          <img
            srcset="
              {%- if section.settings.desktop_image.width >= 165 -%}{{ section.settings.desktop_image | image_url: width: 165 }} 165w,{%- endif -%}
              {%- if section.settings.desktop_image.width >= 330 -%}{{ section.settings.desktop_image | image_url: width: 330 }} 330w,{%- endif -%}
              {%- if section.settings.desktop_image.width >= 535 -%}{{ section.settings.desktop_image | image_url: width: 535 }} 535w,{%- endif -%}
              {%- if section.settings.desktop_image.width >= 750 -%}{{ section.settings.desktop_image | image_url: width: 750 }} 750w,{%- endif -%}
              {%- if section.settings.desktop_image.width >= 1000 -%}{{ section.settings.desktop_image | image_url: width: 1000 }} 1000w,{%- endif -%}
              {{ section.settings.desktop_image | image_url }} {{ section.settings.desktop_image.width }}w
            "
            src="{{ section.settings.desktop_image | image_url: width: 1500 }}"
            width="{{ section.settings.desktop_image.width }}"
            height="{{ section.settings.desktop_image.height }}"
            class="desktop-image"
            loading="lazy"
          >
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

    <div class="desktop-image-with-text image-with-text__text-item grid__item">
      <div
        id="ImageWithText--{{ section.id }}"
        class="custom-image-with-text__content image-with-text__content image-with-text__content--{{ section.settings.desktop_display_type }} image-with-text__content--{{ section.settings.desktop_content_position }} image-with-text__content--desktop-{{ section.settings.desktop_content_alignment }} image-with-text__content--mobile-{{ section.settings.mobile_content_alignment }} image-with-text__content--{{ section.settings.height }} color-{{ section.settings.color_scheme }} content-container"
      >
        {%- for block in section.blocks -%}
          {% case block.type %}
            {%- when 'heading' -%}
              <h2 class="image-with-text__heading {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                {{ block.settings.heading | escape }}
              </h2>
            {%- when 'caption' -%}
              <p
                class="image-with-text__text image-with-text__text--caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }} {{ block.settings.text_style }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.caption | escape }}
              </p>
            {%- when 'text' -%}
              <div class="image-with-text__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            {%- when 'button' -%}
              {%- if block.settings.button_label != blank -%}
                <a
                  {% if block.settings.button_link == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link }}"
                  {% endif %}
                  class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.button_label | escape }}
                </a>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}

        <div id="social_media" class="social-media--{{ section.settings.show_social_media }} desktop_social_media">
          <div class="socials">
            <a href="{{ section.settings.tiktok_url }}" target="_blank"
              ><i class="bx bxl-tiktok desktop_socials"></i
            ></a>
          </div>

          <div class="socials">
            <a href="{{ section.settings.instagram_url }}" target="_blank"
              ><i class="bx bxl-instagram-alt social_icon desktop_socials"></i
            ></a>
          </div>
        </div>
      </div>
    </div>

    <div class="mobile-image-with-text">
      <div class="image-with-text__text-item grid__item">
        <div
          id="ImageWithText--{{ section.id }}"
          class="image-with-text__content image-with-text__content--{{ section.settings.desktop_content_position }} image-with-text__content--desktop-{{ section.settings.desktop_content_alignment }} image-with-text__content--mobile-{{ section.settings.mobile_content_alignment }} image-with-text__content--{{ section.settings.height }} color-{{ section.settings.color_scheme }} content-container"
        >
          {%- for block in section.blocks -%}
            {% case block.type %}
              {%- when 'heading' -%}
                <h2 class="image-with-text__heading {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                  {{ block.settings.heading | escape }}
                </h2>
              {%- when 'caption' -%}
                <p
                  class="image-with-text__text image-with-text__text--caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }} {{ block.settings.text_style }}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.caption | escape }}
                </p>
              {%- when 'text' -%}
                <div class="image-with-text__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </div>
              {%- when 'button' -%}
                {%- if block.settings.button_label != blank -%}
                  <a
                    {% if block.settings.button_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link }}"
                    {% endif %}
                    class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.button_label | escape }}
                  </a>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>

      <!--
        <div class="mobile-image-with-text image-with-text__media-item grid__item">
          <div class="image-with-text__media">
            {%- if section.settings.mobile_image != blank -%}
              <img
                srcset="
                  {%- if section.settings.mobile_image.width >= 165 -%}{{ section.settings.mobile_image | image_url: width: 165 }} 165w,{%- endif -%}
                  {%- if section.settings.mobile_image.width >= 330 -%}{{ section.settings.mobile_image | image_url: width: 330 }} 330w,{%- endif -%}
                  {%- if section.settings.mobile_image.width >= 535 -%}{{ section.settings.mobile_image | image_url: width: 535 }} 535w,{%- endif -%}
                  {%- if section.settings.mobile_image.width >= 750 -%}{{ section.settings.mobile_image | image_url: width: 750 }} 750w,{%- endif -%}
                  {{ section.settings.mobile_image | image_url }} {{ section.settings.mobile_image.width }}w
                "
                src="{{ section.settings.mobile_image | image_url: width: 1500 }}"
                width="{{ section.settings.mobile_image.width }}"
                height="{{ section.settings.mobile_image.height }}"
                class="mobile-image"
                loading="lazy"
              >
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
      -->

      <div class="image-with-text__media-item image-with-text__media-item--{{ section.settings.desktop_image_width }} image-with-text__media-item--{{ section.settings.desktop_content_position }} grid__item">
        <div
          class="image-with-text__media image-with-text__media--{{ section.settings.height }} color-{{ section.settings.color_scheme }} global-media-settings {% if section.settings.image != blank %}media{% else %}image-with-text__media--placeholder placeholder{% endif %}"
          {% if section.settings.height == 'adapt' and section.settings.image != blank %}
            style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
          {% endif %}
          data-mobile-height="{{ section.settings.mobile_height }}"
        >
          {%- if section.settings.mobile_image != blank -%}
            <img
              srcset="
                {%- if section.settings.mobile_image.width >= 165 -%}{{ section.settings.mobile_image | image_url: width: 165 }} 165w,{%- endif -%}
                {%- if section.settings.mobile_image.width >= 330 -%}{{ section.settings.mobile_image | image_url: width: 330 }} 330w,{%- endif -%}
                {%- if section.settings.mobile_image.width >= 535 -%}{{ section.settings.mobile_image | image_url: width: 535 }} 535w,{%- endif -%}
                {%- if section.settings.mobile_image.width >= 750 -%}{{ section.settings.mobile_image | image_url: width: 750 }} 750w,{%- endif -%}
                {{ section.settings.mobile_image | image_url }} {{ section.settings.mobile_image.width }}w
              "
              src="{{ section.settings.mobile_image | image_url: width: 1500 }}"
              width="{{ section.settings.mobile_image.width }}"
              height="{{ section.settings.mobile_image.height }}"
              class="mobile-image"
              loading="lazy"
            >
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        <div id="social_media" class="social-media--{{ section.settings.show_social_media }} mobile_social_media">
          <div class="socials">
            <a href="{{ section.settings.tiktok_url }}" target="_blank"><i class="bx bxl-tiktok mobile_socials"></i></a>
          </div>

          <div class="socials">
            <a href="{{ section.settings.instagram_url }}" target="_blank"
              ><i class="bx bxl-instagram-alt social_icon mobile_socials"></i
            ></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const imageContainers = document.querySelectorAll(".image-with-text__media");

    if (imageContainers.length > 0) {
      const setImageHeight = () => {
        const screenWidth = window.innerWidth;

        imageContainers.forEach((container) => {
          const desktopHeight = container.dataset.desktopHeight;
          const mobileHeight = container.dataset.mobileHeight;

          if (screenWidth <= 768) {
            container.style.height = `${mobileHeight}vw`;
          } else {
            container.style.height = `${desktopHeight}vw`;
          }
        });
      };

      setImageHeight();
      window.addEventListener("resize", setImageHeight);
    }
  });
</script>

