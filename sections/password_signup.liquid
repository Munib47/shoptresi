<section class="tresi_banner">
  <div class="tresi_banner_wrp text-center">
    {% if section.settings.pass_logo != blank %}
      <div class="tresi_logo">
        <img src="{{ section.settings.pass_logo  | img_url: 'master' }}" alt="{{ section.settings.pass_logo.alt }}" />
        <h3>{{ section.settings.pass_logo_txt }}</h3>
      </div>
    {% endif %}

    <div class="tresi_content">
      {% if section.settings.pass_title != blank %}
        <h4>{{ section.settings.pass_title }}</h4>
      {% endif %}

      <div class="tresi_btn_wrp">
        {% if section.settings.notify_btn_txt != blank %}
          <div class="tresi_form">
            <div class="t_btn btn button--primary">
              <a href="#">{{ section.settings.notify_btn_txt }}</a>
            </div>

            <div class="tresi_form_wrp">
              {%- form 'customer', id: 'ContactFooter', class: 'notify_form' -%}
                <div class="form_inner_input">
                  <input type="hidden" name="contact[tags]" value="newsletter">

                  <input
                    id="NewsletterForm--{{ section.id }}"
                    type="email"
                    name="contact[email]"
                    class="form-control tresi_email"
                    value="{{ form.email }}"
                    aria-required="true"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    {% if form.errors %}
                      autofocus
                      aria-invalid="true"
                      aria-describedby="ContactFooter-error"
                    {% elsif form.posted_successfully? %}
                      aria-describedby="ContactFooter-success"
                    {% endif %}
                    placeholder="{{ 'newsletter.label' | t }}"
                    required
                  >

                  <input
                    type="submit"
                    class="btn-icon"
                    name="commit"
                    id="Subscribe"
                    value=""
                  >
                </div>

                {%- if form.errors -%}
                  <small class="newsletter-form__message form__message" id="ContactFooter-error">
                    {%- render 'icon-error' -%}
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </small>
                {%- endif -%}

                {%- if form.posted_successfully? -%}
                  <h4
                    class="newsletter-form__message newsletter-form__message--success form__message"
                    id="ContactFooter-success"
                    tabindex="-1"
                    autofocus
                  >
                    {% render 'icon-success' -%}
                    {{- 'newsletter.success' | t }}
                  </h4>
                {%- endif -%}
              {%- endform -%}
            </div>
          </div>
        {% endif %}

        {% if section.settings.pass_btn_txt != blank %}
          <div class="tresi_form">
            <div class="t_btn border_btn button--secondary">
              <a href="#">{{ section.settings.pass_btn_txt }}</a>
            </div>

            <div class="tresi_form_wrp">
              {%- form 'storefront_password', class: 'presale_form' -%}
                <input
                  type="password"
                  name="password"
                  id="Password"
                  class="form-control tresi_password"
                  autocomplete="current-password"
                  {% if form.errors %}
                    aria-invalid="true"
                    aria-describedby="PasswordLoginForm-password-error"
                  {%- endif -%}
                  placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
                >

                <input type="submit" class="btn-icon" value="">

                {%- if form.errors -%}
                  <div id="PasswordLoginForm-password-error" role="status">
                    <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                    <span class="form__message">
                      {%- render 'icon-error' %}
                      {{ 'general.password_page.login_form_error' | t -}}
                    </span>
                  </div>
                {%- endif -%}
              {%- endform -%}
            </div>

            {% if section.settings.contect_btn_txt != blank %}
              <div class="tresi_form">
                <div class="contact_btn btn button--primary">
                  <a href="{{ section.settings.contect_btn_url }}">{{ section.settings.contect_btn_txt }}</a>
                </div>
              </div>
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.insta_url != blank %}
          <div class="tresi_social">
            <a href="{{ section.settings.insta_url }}" class="social_link1">
              <svg aria-hidden="true" focusable="false" class="icon icon-instagram" viewBox="0 0 18 18">
                <path fill="currentColor" d="M8.77 1.58c2.34 0 2.62.01 3.54.05.86.04 1.32.18 1.63.3.41.17.7.35 1.01.66.3.3.5.6.65 1 .12.32.27.78.3 1.64.05.92.06 1.2.06 3.54s-.01 2.62-.05 3.54a4.79 4.79 0 01-.3 1.63c-.17.41-.35.7-.66 1.01-.3.3-.6.5-1.01.66-.31.12-.77.26-1.63.3-.92.04-1.2.05-3.54.05s-2.62 0-3.55-.05a4.79 4.79 0 01-1.62-.3c-.42-.16-.7-.35-1.01-.66-.31-.3-.5-.6-.66-1a4.87 4.87 0 01-.3-1.64c-.04-.92-.05-1.2-.05-3.54s0-2.62.05-3.54c.04-.86.18-1.32.3-1.63.16-.41.35-.7.66-1.01.3-.3.6-.5 1-.65.32-.12.78-.27 1.63-.3.93-.05 1.2-.06 3.55-.06zm0-1.58C6.39 0 6.09.01 5.15.05c-.93.04-1.57.2-2.13.4-.57.23-1.06.54-1.55 1.02C1 1.96.7 2.45.46 3.02c-.22.56-.37 1.2-.4 2.13C0 6.1 0 6.4 0 8.77s.01 2.68.05 3.61c.04.94.2 1.57.4 2.13.23.58.54 1.07 1.02 1.56.49.48.98.78 1.55 1.01.56.22 1.2.37 2.13.4.94.05 1.24.06 3.62.06 2.39 0 2.68-.01 3.62-.05.93-.04 1.57-.2 2.13-.41a4.27 4.27 0 001.55-1.01c.49-.49.79-.98 1.01-1.56.22-.55.37-1.19.41-2.13.04-.93.05-1.23.05-3.61 0-2.39 0-2.68-.05-3.62a6.47 6.47 0 00-.4-2.13 4.27 4.27 0 00-1.02-1.55A4.35 4.35 0 0014.52.46a6.43 6.43 0 00-2.13-.41A69 69 0 008.77 0z"></path>
                <path fill="currentColor" d="M8.8 4a4.5 4.5 0 100 9 4.5 4.5 0 000-9zm0 7.43a2.92 2.92 0 110-5.85 2.92 2.92 0 010 5.85zM13.43 5a1.05 1.05 0 100-2.1 1.05 1.05 0 000 2.1z"></path>
              </svg>
            </a>
          </div>
        {% endif %}
      </div>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="tresi_bottom_content">
        <ul>
          {% for block in section.blocks %}
            <li>{{ block.settings.content-txt }}</li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .tresi_content .newsletter-form__message {
    position: absolute;
    top: -50px;
    margin: 0;
    left: 0;
    right: 0;
    font-size: 14px;
    justify-content: center;
  }
  
  .form__message {
    position: absolute;
    top: -100px;
    margin: 0;
    left: 0;
    right: 0;
    font-size: 14px;
    justify-content: center;
    display: flex;
    color: red;
  }

  input:-webkit-autofill,
  input:-webkit-autofill:hover,
  input:-webkit-autofill:focus,
  input:-webkit-autofill:active {
    transition: background-color 5000000s ease-in-out 0s;
    -webkit-box-shadow: 0 0 0 30px var(--dark-blue) inset !important;
  }
  
  {% if section.settings.back-mobile-img != blank %}     
    @media screen and (max-width: 750px) {
      body.password.gradient {
        background: url({{ section.settings.back-mobile-img | img_url: 'master' }}) !important;
        background-size: cover !important;
        background-repeat: no-repeat !important;
        overflow-x: hidden !important;
      }
    }
  {% endif %}
  
  {% if section.settings.back-img != blank %}
    @media screen and (min-width: 749px) {
      .flex-container {
        background: url({{ section.settings.back-img | img_url: 'master' }}) no-repeat center center fixed ;
        background-size: cover;
      }
    }
  {% endif %}
</style>

<script async src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>

<script>
  $(document).ready(function() {
    $(".t_btn").on("click", function(e) {
      e.preventDefault();
      $(".t_btn").removeClass("open");
      $(".tresi_form_wrp").removeClass("open");
      $(this).addClass("open");
      $(this).parents(".tresi_form").find(".tresi_form_wrp").addClass("open");
    });
  });
</script>

{% schema %}
{
  "name": "PassWord Signup",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "image_picker",
      "id": "back-img",
      "label": "Add Desktop Background Image"
    },
    {
      "type": "image_picker",
      "id": "back-mobile-img",
      "label": "Add Mobile Background Image"
    },
    {
      "type": "image_picker",
      "id": "pass_logo",
      "label": "Add Logo Image"
    },
    {
      "type": "richtext",
      "id": "pass_logo_txt",
      "label": "Add Logo Text"
    },
    {
      "type": "richtext",
      "id": "pass_title",
      "label": "Add Title"
    },
    {
      "type": "text",
      "id": "notify_btn_txt",
      "label": "Add Notify Me Title"
    },
    {
      "type": "text",
      "id": "pass_btn_txt",
      "label": "Add Password Button Title"
    },
    {
      "type": "text",
      "id": "contect_btn_txt",
      "label": "Add Contect Button Title"
    },
    {
      "type": "url",
      "id": "contect_btn_url",
      "label": "Add Contect Button Url"
    },
    {
      "type": "url",
      "id": "insta_url",
      "label": "Add Instagram Url"
    }
  ],
  "blocks": [
     {
       "name": "Bottom Content",
       "type": "bottom-content",
       "settings": [
         {
           "type": "text",
           "id": "content-txt",
           "label": "Add Bottom Content"
         }
       ]
     }
  ]
}
{% endschema %}
