      "id": "stack_images_on_mobile",
      "default": true,
      "label": "t:sections.image-banner.settings.stack_images_on_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "show_text_below",
      "default": true,
      "label": "t:sections.image-banner.settings.show_text_below.label"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.image-banner.blocks.heading.name",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Image banner",
          "label": "t:sections.image-banner.blocks.heading.settings.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h0",
              "label": "t:sections.all.heading_size.options__3.label"
            }
          ],
          "default": "h0",
          "label": "Desktop heading size"
        },
        {
          "type": "select",
          "id": "mobile_heading_size",
          "options": [
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h0",
              "label": "t:sections.all.heading_size.options__3.label"
            }
          ],
          "default": "h0",
          "label": "Mobile heading size"
        },
        {
          "type": "color",
          "id": "heading_color_desktop",
          "label": "Desktop heading color",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "heading_hover_color_desktop",
          "label": "Desktop heading hover color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "heading_color_mobile",
          "label": "Mobile heading color",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "heading_hover_color_mobile",
          "label": "Mobile heading hover color",
          "default": "#ffffff"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.image-banner.blocks.text.name",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "text",
