<script>
  document.addEventListener('DOMContentLoaded', function() {
    var $scrollContainer = $("#scroll-container");
    var targetScrollPos = 0;
    var isScrolling = false;
    var mouseMoveTimer;
    var initialScrollDone = false;

    function scrollToEndOfColumn1() {
      var columnWidth = $(".column").first().outerWidth(true);
      var viewportWidth = $(window).width();
      var marginSize = 0.015 * viewportWidth;
  
      $scrollContainer.scrollLeft(columnWidth - marginSize);
      initialScrollDone = true;
    }
    
    if (!initialScrollDone) {
      scrollToEndOfColumn1();
    }

    $scrollContainer.on("mousemove", function(e) {
      var containerWidth = $(this).width();
      var mouseX = e.clientX - $(this).offset().left;
      var scrollWidth = this.scrollWidth - containerWidth;

      targetScrollPos = (mouseX / containerWidth) * scrollWidth;
      isScrolling = true;

      clearTimeout(mouseMoveTimer);
      mouseMoveTimer = setTimeout(function() {
        isScrolling = false;
      }, 50);
    });

    $scrollContainer.on("mouseleave", function() {
      isScrolling = false;
      clearTimeout(mouseMoveTimer);
    });

    $(window).on("blur", function() {
      isScrolling = false;
      clearTimeout(mouseMoveTimer);
    });

    (function animateScroll() {
      if (isScrolling) {
        var currentScrollPos = $scrollContainer.scrollLeft();
        var scrollDelta = (targetScrollPos - currentScrollPos) * 0.1;
        $scrollContainer.scrollLeft(currentScrollPos + scrollDelta);
      }
      requestAnimationFrame(animateScroll);
    })();
  });

