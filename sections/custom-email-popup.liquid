<style>
  /* ── Custom Popup Overlay ─────────────────────────────── */
  #tresi-popup-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    z-index: 99998;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  #tresi-popup-overlay.tresi-visible {
    opacity: 1;
  }

  /* ── Popup Box ────────────────────────────────────────── */
  #tresi-popup {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -48%) scale(0.97);
    z-index: 99999;
    width: 92%;
    max-width: 480px;
    background: #fff;
    display: none;
    flex-direction: column;
    opacity: 0;
    transition: opacity 0.35s ease, transform 0.35s ease;
    font-family: HelveticaLight, Helvetica, Arial, sans-serif;
  }
  #tresi-popup.tresi-visible {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  /* ── Close Button ─────────────────────────────────────── */
  #tresi-popup-close {
    position: absolute;
    top: 10px;
    right: 14px;
    background: none;
    border: none;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    color: #333;
    padding: 4px 8px;
    z-index: 2;
  }
  #tresi-popup-close:hover { color: #000; }

  /* ── Banner Image ─────────────────────────────────────── */
  #tresi-popup-banner {
    width: 100%;
    aspect-ratio: 16/7;
    object-fit: cover;
    display: block;
  }

  /* ── Content ──────────────────────────────────────────── */
  #tresi-popup-content {
    padding: 28px 32px 32px;
    text-align: center;
  }

  #tresi-popup-tag {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 8px;
  }

  #tresi-popup-heading {
    font-family: HelveticaMed, Helvetica, Arial, sans-serif;
    font-size: 18px;
    font-weight: normal;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #111;
    margin: 0 0 8px;
    line-height: 1.3;
  }

  #tresi-popup-sub {
    font-size: 12px;
    color: #555;
    letter-spacing: 0.04em;
    margin-bottom: 20px;
    line-height: 1.5;
  }

  /* ── Form ─────────────────────────────────────────────── */
  #tresi-popup-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tresi-popup-row {
    display: flex;
    gap: 8px;
  }

  .tresi-popup-input {
    flex: 1;
    height: 42px;
    border: 1px solid #ccc;
    padding: 0 14px;
    font-size: 12px;
    font-family: HelveticaLight, Helvetica, Arial, sans-serif;
    letter-spacing: 0.04em;
    color: #111;
    background: #fff;
    outline: none;
    border-radius: 0;
    -webkit-appearance: none;
  }
  .tresi-popup-input::placeholder { color: #aaa; }
  .tresi-popup-input:focus { border-color: #111; }

  /* phone row */
  #tresi-popup-phone-wrap {
    display: flex;
    gap: 8px;
  }
  #tresi-popup-flag {
    height: 42px;
    border: 1px solid #ccc;
    padding: 0 10px;
    font-size: 13px;
    background: #fff;
    cursor: default;
    display: flex;
    align-items: center;
    white-space: nowrap;
    color: #555;
    letter-spacing: 0.02em;
    min-width: 60px;
    justify-content: center;
  }

  #tresi-popup-btn {
    width: 100%;
    height: 44px;
    background: #111;
    color: #fff;
    border: none;
    font-family: HelveticaMed, Helvetica, Arial, sans-serif;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s;
  }
  #tresi-popup-btn:hover { background: #333; }

  /* ── Legal ────────────────────────────────────────────── */
  #tresi-popup-legal {
    font-size: 9.5px;
    color: #999;
    line-height: 1.5;
    margin-top: 12px;
    letter-spacing: 0.02em;
  }
  #tresi-popup-legal a { color: #999; text-decoration: underline; }

  /* ── Skip link ────────────────────────────────────────── */
  #tresi-popup-skip {
    display: block;
    text-align: center;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #888;
    margin-top: 14px;
    cursor: pointer;
    text-decoration: underline;
    background: none;
    border: none;
    width: 100%;
    font-family: HelveticaLight, Helvetica, Arial, sans-serif;
  }

  /* ── Success State ────────────────────────────────────── */
  #tresi-popup-success {
    display: none;
    padding: 40px 32px;
    text-align: center;
  }
  #tresi-popup-success h3 {
    font-family: HelveticaMed, Helvetica, Arial, sans-serif;
    font-size: 16px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 10px;
  }
  #tresi-popup-success p {
    font-size: 12px;
    color: #555;
    margin: 0;
  }

  /* ── Mobile ───────────────────────────────────────────── */
  @media (max-width: 480px) {
    #tresi-popup { width: 96%; }
    #tresi-popup-content { padding: 22px 20px 26px; }
    #tresi-popup-heading { font-size: 16px; }
    .tresi-popup-row { flex-direction: column; gap: 8px; }
  }
</style>

{%- if section.settings.enable_popup -%}

<!-- Popup Overlay -->
<div id="tresi-popup-overlay" role="dialog" aria-modal="true" aria-labelledby="tresi-popup-heading"></div>

<!-- Popup -->
<div id="tresi-popup" role="document">
  <button id="tresi-popup-close" aria-label="Close popup">&times;</button>

  {%- if section.settings.banner_image -%}
    <img
      id="tresi-popup-banner"
      src="{{ section.settings.banner_image | image_url: width: 960 }}"
      alt="{{ section.settings.heading | escape }}"
      width="960"
      height="420"
      loading="lazy"
    >
  {%- endif -%}

  <div id="tresi-popup-content">

    <!-- Normal Form -->
    <div id="tresi-popup-form-wrap">
      {%- if section.settings.tag_text != blank -%}
        <p id="tresi-popup-tag">{{ section.settings.tag_text }}</p>
      {%- endif -%}

      <h2 id="tresi-popup-heading">{{ section.settings.heading }}</h2>

      {%- if section.settings.subtext != blank -%}
        <p id="tresi-popup-sub">{{ section.settings.subtext }}</p>
      {%- endif -%}

      <form id="tresi-popup-form" novalidate>
        <!-- Name row -->
        {%- if section.settings.show_name -%}
          <div class="tresi-popup-row">
            <input class="tresi-popup-input" type="text" id="tresi-first" name="first_name" placeholder="{{ section.settings.first_name_placeholder | default: 'FIRST NAME' }}" autocomplete="given-name">
            <input class="tresi-popup-input" type="text" id="tresi-last" name="last_name" placeholder="{{ section.settings.last_name_placeholder | default: 'LAST NAME' }}" autocomplete="family-name">
          </div>
        {%- endif -%}

        <!-- Email -->
        <input class="tresi-popup-input" type="email" id="tresi-email" name="email" placeholder="{{ section.settings.email_placeholder | default: 'EMAIL ADDRESS' }}" required autocomplete="email">

        <!-- Phone -->
        {%- if section.settings.show_phone -%}
          <div id="tresi-popup-phone-wrap">
            <div id="tresi-popup-flag">🇺🇸 +1</div>
            <input class="tresi-popup-input" type="tel" id="tresi-phone" name="phone" placeholder="{{ section.settings.phone_placeholder | default: 'PHONE NUMBER (OPTIONAL)' }}" autocomplete="tel">
          </div>
        {%- endif -%}

        <button type="submit" id="tresi-popup-btn">{{ section.settings.button_text | default: 'UNLOCK DISCOUNT' }}</button>
      </form>

      {%- if section.settings.legal_text != blank -%}
        <p id="tresi-popup-legal">{{ section.settings.legal_text }}</p>
      {%- endif -%}

      <button id="tresi-popup-skip">{{ section.settings.skip_text | default: 'No thanks' }}</button>
    </div>

    <!-- Success State -->
    <div id="tresi-popup-success">
      <h3>{{ section.settings.success_heading | default: 'Thank you!' }}</h3>
      <p>{{ section.settings.success_text | default: 'Your discount code is on its way.' }}</p>
    </div>

  </div>
</div>

<script>
(function() {
  'use strict';

  var COOKIE = 'tresi_popup_shown';
  var DELAY  = {{ section.settings.delay_seconds | default: 6 }} * 1000;
  var KLAVIYO_LIST_ID = '{{ section.settings.klaviyo_list_id }}';

  /* ── Cookie helpers ─────────────────────────────────── */
  function setCookie(name, days) {
    var d = new Date();
    d.setTime(d.getTime() + days * 864e5);
    document.cookie = name + '=1;expires=' + d.toUTCString() + ';path=/;SameSite=Lax';
  }
  function getCookie(name) {
    return document.cookie.split(';').some(function(c) {
      return c.trim().startsWith(name + '=');
    });
  }

  /* ── Show / Hide ────────────────────────────────────── */
  function showPopup() {
    var overlay = document.getElementById('tresi-popup-overlay');
    var popup   = document.getElementById('tresi-popup');
    if (!overlay || !popup) return;

    overlay.style.display = 'block';
    popup.style.display   = 'flex';

    requestAnimationFrame(function() {
      requestAnimationFrame(function() {
        overlay.classList.add('tresi-visible');
        popup.classList.add('tresi-visible');
      });
    });

    document.body.style.overflow = 'hidden';
  }

  function hidePopup() {
    var overlay = document.getElementById('tresi-popup-overlay');
    var popup   = document.getElementById('tresi-popup');
    if (!overlay || !popup) return;

    overlay.classList.remove('tresi-visible');
    popup.classList.remove('tresi-visible');

    setTimeout(function() {
      overlay.style.display = 'none';
      popup.style.display   = 'none';
      document.body.style.overflow = '';
    }, 350);

    setCookie(COOKIE, {{ section.settings.reshow_days | default: 30 }});
  }

  /* ── Submit to Klaviyo API (if list ID provided) ────── */
  function subscribeKlaviyo(email, firstName, lastName, phone) {
    if (!KLAVIYO_LIST_ID) return Promise.resolve();

    var payload = {
      data: {
        type: 'subscription',
        attributes: {
          profile: {
            data: {
              type: 'profile',
              attributes: {
                email: email,
                first_name: firstName || '',
                last_name: lastName || '',
                phone_number: phone || ''
              }
            }
          }
        },
        relationships: {
          list: {
            data: { type: 'list', id: KLAVIYO_LIST_ID }
          }
        }
      }
    };

    return fetch('https://a.klaviyo.com/client/subscriptions/?company_id={{ section.settings.klaviyo_public_key }}', {
      method: 'POST',
      headers: {
        'content-type': 'application/json',
        'revision': '2023-12-15'
      },
      body: JSON.stringify(payload)
    });
  }

  /* ── Shopify Customer Subscribe (fallback) ──────────── */
  function subscribeShopify(email) {
    var form = document.createElement('form');
    form.action = '/contact';
    form.method = 'POST';

    var fields = {
      form_type: 'customer',
      utf8: '✓',
      'contact[email]': email,
      'contact[tags]': 'newsletter'
    };

    Object.keys(fields).forEach(function(key) {
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = key;
      input.value = fields[key];
      form.appendChild(input);
    });

    document.body.appendChild(form);
    form.submit();
  }

  /* ── Form submit ────────────────────────────────────── */
  function handleSubmit(e) {
    e.preventDefault();

    var emailEl = document.getElementById('tresi-email');
    var email   = emailEl ? emailEl.value.trim() : '';
    if (!email || !email.includes('@')) {
      emailEl.focus();
      emailEl.style.borderColor = '#c00';
      return;
    }
    emailEl.style.borderColor = '';

    var firstName = (document.getElementById('tresi-first') || {}).value || '';
    var lastName  = (document.getElementById('tresi-last')  || {}).value || '';
    var phone     = (document.getElementById('tresi-phone') || {}).value || '';

    var btn = document.getElementById('tresi-popup-btn');
    if (btn) { btn.textContent = '...'; btn.disabled = true; }

    var done = function() {
      document.getElementById('tresi-popup-form-wrap').style.display = 'none';
      document.getElementById('tresi-popup-success').style.display   = 'block';
      setCookie(COOKIE, {{ section.settings.reshow_days | default: 30 }});
      setTimeout(hidePopup, 2800);
    };

    if (KLAVIYO_LIST_ID) {
      subscribeKlaviyo(email, firstName, lastName, phone).then(done).catch(done);
    } else {
      done();
    }
  }

  /* ── Init ───────────────────────────────────────────── */
  function init() {
    if (getCookie(COOKIE)) return;

    setTimeout(function() {
      showPopup();

      var form    = document.getElementById('tresi-popup-form');
      var close   = document.getElementById('tresi-popup-close');
      var overlay = document.getElementById('tresi-popup-overlay');
      var skip    = document.getElementById('tresi-popup-skip');

      if (form)    form.addEventListener('submit', handleSubmit);
      if (close)   close.addEventListener('click', hidePopup);
      if (overlay) overlay.addEventListener('click', hidePopup);
      if (skip)    skip.addEventListener('click', hidePopup);

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') hidePopup();
      });
    }, DELAY);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

{%- endif -%}

